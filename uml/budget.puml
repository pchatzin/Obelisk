@startuml
title Obelisk Project UML Diagram (Budget Branch)

package budget {
  class "budget2025.csv" as Budget2025Csv
}

package docs {
  class "Ex guide.docx" as ExGuideDocx
  class "KED-Odigos-Ylopoiisis-gia-Paroxous-WS_v0_90.pdf" as KedWsPdf
  class "KED_client_specs_v1.5_0.pdf" as KedClientSpecsPdf
  class "README.md" as ReadmeMd
  class "exer.txt" as ExerTxt
  class "tech-report.md" as TechReportMd
}

class "pom.xml" as PomXml
class promo

package com.obelisk {
  class ObeliskApplication
  class BudgetAnalyzer
  class "BudgetAnalyzer$Entry" as BudgetAnalyzerEntry
  class "BudgetAnalyzer$Category" as BudgetAnalyzerCategory

  package budget_db {
    class BudgetEntry
    class BudgetEntryRepository
    class BudgetImporter
    class PdfBudgetParser
  }
}

package resources {
  class "application.properties" as AppPropsRes
  class "budget-2025.pdf" as Budget2025PdfRes
}

package "target.classes" {
  class "application.properties" as AppPropsTarget
  class "budget-2025.pdf" as Budget2025PdfTarget

  package com.obelisk {
    class "ObeliskApplication.class" as ObeliskApplicationClass
    class "BudgetAnalyzer.class" as BudgetAnalyzerClass
    class "BudgetAnalyzer$Entry.class" as BudgetAnalyzerEntryClass
    class "BudgetAnalyzer$Category.class" as BudgetAnalyzerCategoryClass

    package budget_db {
      class "BudgetEntry.class" as BudgetEntryClass
      class "BudgetEntryRepository.class" as BudgetEntryRepositoryClass
      class "BudgetImporter.class" as BudgetImporterClass
      class "PdfBudgetParser.class" as PdfBudgetParserClass
      class "PdfBudgetParser$BoldOnlyTextStripper.class" as BoldOnlyTextStripperClass
    }
  }
}

package uml {
  class "budget.puml" as BudgetPuml
  class "budget.png" as BudgetPng
}

' Relationships (logical)
ObeliskApplication --> BudgetAnalyzer : uses
BudgetAnalyzer --> BudgetAnalyzerEntry : contains
BudgetAnalyzer --> BudgetAnalyzerCategory : categorizes
BudgetAnalyzer --> BudgetEntry : analyzes
BudgetImporter --> BudgetEntry : creates
BudgetImporter --> PdfBudgetParser : parses
BudgetEntryRepository --> BudgetEntry : manages
PdfBudgetParser --> Budget2025PdfRes : reads
BudgetImporter --> Budget2025Csv : imports

@enduml
